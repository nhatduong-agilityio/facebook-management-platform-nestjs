<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="fcp-billing-sm" name="BillingStateMachine">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Subscription State Machine — Billing Service (Stripe)" style="text;html=1;align=center;fontSize=20;fontStyle=1;fontColor=#1F6FC4;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="860" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Guarded transitions · every transition writes a billing_events row (from → to, actor, timestamp) · illegal transitions rejected as Result.Err" style="text;html=1;align=center;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="120" y="50" width="860" height="22" as="geometry" />
        </mxCell>

        <!-- start -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#34495E;strokeColor=#34495E;" vertex="1" parent="1">
          <mxGeometry x="110" y="140" width="24" height="24" as="geometry" />
        </mxCell>

        <!-- states -->
        <mxCell id="s_trial" value="&lt;b&gt;trialing&lt;/b&gt;&lt;br&gt;(TRIAL)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1F6FC4;fillColor=#DCE6F2;fontColor=#1A3C6E;fontSize=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="240" y="120" width="150" height="64" as="geometry" />
        </mxCell>
        <mxCell id="s_active" value="&lt;b&gt;active&lt;/b&gt;&lt;br&gt;(ACTIVE)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1E8449;fillColor=#D8EFE0;fontColor=#145A32;fontSize=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="120" width="150" height="64" as="geometry" />
        </mxCell>
        <mxCell id="s_grace" value="&lt;b&gt;grace_period&lt;/b&gt;&lt;br&gt;(PAST_DUE)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#B9770E;fillColor=#FDF0D5;fontColor=#7E5109;fontSize=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="330" width="150" height="64" as="geometry" />
        </mxCell>
        <mxCell id="s_cancel" value="&lt;b&gt;cancelled&lt;/b&gt;&lt;br&gt;(terminal)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C0392B;fillColor=#F9D7D4;fontColor=#922B21;fontSize=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="240" y="330" width="150" height="64" as="geometry" />
        </mxCell>

        <!-- end -->
        <mxCell id="end" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34495E;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="108" y="350" width="26" height="26" as="geometry" />
        </mxCell>

        <!-- transitions -->
        <mxCell id="t_start" value="checkout.completed / free signup" style="endArrow=block;html=1;strokeColor=#34495E;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="start" target="s_trial"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t_pay1" value="invoice.paid" style="endArrow=block;html=1;strokeColor=#34495E;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="s_trial" target="s_active"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t_fail" value="invoice.payment_failed → set grace_period_end" style="endArrow=block;html=1;strokeColor=#B9770E;strokeWidth=2;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s_active" target="s_grace"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t_recover" value="invoice.paid (recovered)" style="endArrow=block;html=1;strokeColor=#1E8449;strokeWidth=2;fontSize=10;exitX=0.15;exitY=0;entryX=0.15;entryY=1;" edge="1" parent="1" source="s_grace" target="s_active"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t_trialgrace" value="trial expired, no payment" style="endArrow=block;html=1;strokeColor=#B9770E;strokeWidth=2;fontSize=10;exitX=0.5;exitY=1;entryX=0;entryY=0.4;" edge="1" parent="1" source="s_trial" target="s_grace"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t_gracecancel" value="grace expired" style="endArrow=block;html=1;strokeColor=#C0392B;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="s_grace" target="s_cancel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t_actcancel" value="customer.subscription.deleted" style="endArrow=block;html=1;strokeColor=#C0392B;strokeWidth=2;fontSize=10;exitX=0.25;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="s_active" target="s_cancel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t_end" style="endArrow=block;html=1;strokeColor=#34495E;strokeWidth=2;" edge="1" parent="1" source="s_cancel" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- free-plan guard note -->
        <mxCell id="guard" value="&lt;b&gt;Free-plan guard (BR-F10):&lt;/b&gt; code = 'free' may only be trialing or active — grace_period / cancelled transitions disabled, grace_period_end stays NULL. No Stripe customer exists to be past-due on." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#B7C2CC;fillColor=#F4F6F8;fontColor=#333333;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="240" y="440" width="520" height="60" as="geometry" />
        </mxCell>

        <!-- transition log note -->
        <mxCell id="log" value="&lt;b&gt;Transition log (every edge):&lt;/b&gt; billing_events { stripe_event_id, event_type, from_state, to_state, actor, occurred_at } — emits SubscriptionActivated / SubscriptionPastDue / SubscriptionCancelled to RabbitMQ." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1F6FC4;fillColor=#EEF5FB;fontColor=#1A3C6E;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="240" y="510" width="520" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
