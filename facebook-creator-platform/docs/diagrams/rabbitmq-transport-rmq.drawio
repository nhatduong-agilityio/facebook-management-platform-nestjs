      <mxCell id="t" value="Transport.RMQ Core Mechanics — How NestJS wraps RabbitMQ" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
        <mxGeometry x="227" y="14" width="1200" height="36" as="geometry" />
