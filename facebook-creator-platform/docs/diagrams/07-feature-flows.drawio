<mxCell id="title" value="Feature Flow — Billing Checkout (Stripe)" style="text;html=1;align=center;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="14" width="800" height="34" as="geometry"/></mxCell>

<mxCell id="b1" value="1. POST /billing/checkout&#xa;{ planCode }" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="b2" value="2. BillingTcpAdapter&#xa;billing.checkout TCP&#xa;→ { url }" style="rounded=1;fillColor=#fff8e1;strokeColor=#E0A21E;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="b3" value="3. BillingService&#xa;create Stripe Checkout Session&#xa;→ returns session URL" style="rounded=1;fillColor=#fff8e1;strokeColor=#E0A21E;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="90" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="b4" value="4. Stripe API&#xa;hosted checkout page" style="rounded=1;fillColor=#EAF1FE;strokeColor=#3A5BD9;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="90" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="b5" value="5. 200 { url }&#xa;Client redirects to Stripe" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="90" width="180" height="70" as="geometry"/></mxCell>

<mxCell id="b6" value="6. User pays on Stripe&#xa;checkout.session.completed" style="rounded=1;fillColor=#EAF1FE;strokeColor=#3A5BD9;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="280" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="b7" value="7. Stripe → POST /webhooks/stripe&#xa;BillingWebhookController (HTTP :3001)" style="rounded=1;fillColor=#fff8e1;strokeColor=#E0A21E;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="280" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="b8" value="8. Stripe signature verify&#xa;(rawBody required)" style="rounded=1;fillColor=#fff8e1;strokeColor=#E0A21E;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="280" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="b9" value="9. BillingService&#xa;subscription state → active&#xa;em.flush()" style="rounded=1;fillColor=#fff8e1;strokeColor=#E0A21E;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="280" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="b10" value="10. billing.subscription_activated&#xa;→ RMQ → notification + audit" style="rounded=1;fillColor=#f3eafb;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="280" width="220" height="70" as="geometry"/></mxCell>

<mxCell id="e12" value="TCP" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E0A21E;fontSize=9;" edge="1" source="b1" target="b2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
