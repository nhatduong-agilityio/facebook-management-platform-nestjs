<!-- PAGE 5 — PUBLISH POST (CRON) -->
<diagram id="f5" name="5. Publish Post (Cron)">
<mxGraphModel dx="1600" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="800" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>

<mxCell id="title" value="Feature Flow — Publish Post (@Cron every minute)" style="text;html=1;align=center;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="14" width="1000" height="34" as="geometry"/></mxCell>

<mxCell id="p1" value="1. @Cron('*/1 * * * *')&#xa;PublishPostJob fires" style="rounded=1;fillColor=#EEEEEE;strokeColor=#4A4A4A;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="p2" value="2. PostRepository&#xa;findScheduledDue()&#xa;WHERE status=scheduled&#xa;AND scheduledAt ≤ now()" style="rounded=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="p3" value="3. For each post:&#xa;status → publishing&#xa;em.flush()" style="rounded=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="90" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="p4" value="4. FacebookAccountRepository&#xa;findById(post.facebookAccountId)&#xa;decrypt access token (AES-256-GCM)" style="rounded=1;fillColor=#EEEEEE;strokeColor=#4A4A4A;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="80" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="p5" value="5. Facebook Graph API&#xa;POST /me/feed&#xa;{ message, access_token }" style="rounded=1;fillColor=#EAF1FE;strokeColor=#3A5BD9;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="80" width="200" height="90" as="geometry"/></mxCell>

<mxCell id="p6a" value="6a. Success&#xa;status → published&#xa;facebookPostId saved&#xa;em.flush()" style="rounded=1;fillColor=#1b5e20;fontColor=#FFFFFF;strokeColor=#1b5e20;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="280" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="p6b" value="6b. Failure&#xa;status → failed&#xa;errorMessage saved&#xa;em.flush()" style="rounded=1;fillColor=#b71c1c;fontColor=#FFFFFF;strokeColor=#b71c1c;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="280" width="180" height="90" as="geometry"/></mxCell>

<mxCell id="p7a" value="7a. posts.published&#xa;→ search + notification&#xa;+ email + analytics + audit" style="rounded=1;fillColor=#f3eafb;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="430" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="p7b" value="7b. posts.failed&#xa;→ search + notification&#xa;+ email + audit" style="rounded=1;fillColor=#f3eafb;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="430" width="200" height="80" as="geometry"/></mxCell>

<mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p1" target="p2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p2" target="p3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p3" target="p4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e45" value="FB Graph API" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#3A5BD9;fontSize=9;" edge="1" source="p4" target="p5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e_ok" value="200 OK" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2e7d32;fontSize=9;" edge="1" source="p5" target="p6a" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e_fail" value="error" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b71c1c;fontSize=9;" edge="1" source="p5" target="p6b" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6a7a" value="RMQ" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;fontSize=9;" edge="1" source="p6a" target="p7a" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6b7b" value="RMQ" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;fontSize=9;" edge="1" source="p6b" target="p7b" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>

<!-- PAGE 6 — FACEBOOK OAUTH CONNECT -->
<diagram id="f6" name="6. Facebook OAuth Connect">
<mxGraphModel dx="1600" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="700" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>

<mxCell id="title" value="Feature Flow — Facebook OAuth Connect" style="text;html=1;align=center;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="14" width="800" height="34" as="geometry"/></mxCell>

<mxCell id="o1" value="1. GET /facebook/auth&#xa;→ redirect to FB OAuth" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="o2" value="2. User grants permission&#xa;Facebook redirects to&#xa;GET /facebook/callback?code=..." style="rounded=1;fillColor=#EAF1FE;strokeColor=#3A5BD9;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="o3" value="3. Exchange code → access_token&#xa;Facebook Graph API /oauth/token" style="rounded=1;fillColor=#EAF1FE;strokeColor=#3A5BD9;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="80" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="o4" value="4. Fetch page list&#xa;GET /me/accounts&#xa;→ pages[] with page tokens" style="rounded=1;fillColor=#EAF1FE;strokeColor=#3A5BD9;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="80" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="o5" value="5. EncryptedText.encrypt(pageToken)&#xa;AES-256-GCM&#xa;Never logged (PII)" style="rounded=1;fillColor=#fff9c4;strokeColor=#f9a825;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="80" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="o6" value="6. new FacebookAccount(uuid v7)&#xa;em.persist() em.flush()&#xa;→ INSERT facebook_accounts" style="rounded=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="260" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="o7" value="7. facebook.token_expiring scheduled&#xa;(cron token-refresh check)" style="rounded=1;fillColor=#EEEEEE;strokeColor=#4A4A4A;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="260" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="o8" value="8. 201 { facebookAccountId }" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="260" width="210" height="70" as="geometry"/></mxCell>

<mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="o1" target="o2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e23" value="FB OAuth" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#3A5BD9;fontSize=9;" edge="1" source="o2" target="o3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="o3" target="o4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="o4" target="o5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e56" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="o5" target="o6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e67" value="cron watch" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#4A4A4A;fontSize=9;" edge="1" source="o6" target="o7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e68" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="o6" target="o8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>

