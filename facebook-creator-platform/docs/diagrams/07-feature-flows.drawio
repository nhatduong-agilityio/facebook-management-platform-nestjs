<!-- PAGE 2 — DELETE WORKSPACE (W-1) -->
<diagram id="f2" name="2. Delete Workspace (W-1)">
<mxGraphModel dx="1600" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
