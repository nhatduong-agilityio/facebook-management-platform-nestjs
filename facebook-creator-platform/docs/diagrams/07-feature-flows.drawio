<mxCell id="title" value="Feature Flow — Delete Workspace (W-1 Task)" style="text;html=1;align=center;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="14" width="900" height="34" as="geometry"/></mxCell>

<!-- Guard chain -->
<mxCell id="guard_z" value="Guard Chain (WorkspaceService.deleteWorkspace)" style="swimlane;startSize=30;fillColor=#e8f4ff;strokeColor=#2D6CDF;strokeWidth=3;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="760" height="200" as="geometry"/></mxCell>
<mxCell id="g1" value="1. ClerkGuard JWT → userId" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;" vertex="1" parent="guard_z"><mxGeometry x="10" y="50" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="g2" value="2. WorkspaceGuard&#xa;load workspace (soft-delete filter on)&#xa;→ 404 if not found" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;" vertex="1" parent="guard_z"><mxGeometry x="190" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="g3" value="3. RoleGuard&#xa;requesterRole === OWNER?&#xa;→ 403 if not" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;" vertex="1" parent="guard_z"><mxGeometry x="370" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="g4" value="4. workspace.deletedAt&#xa;already set? → 409&#xa;WORKSPACE_ALREADY_DELETED" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;fontSize=11;" vertex="1" parent="guard_z"><mxGeometry x="550" y="40" width="170" height="70" as="geometry"/></mxCell>

<!-- Cascade flush -->
<mxCell id="cas_z" value="Cascade within ONE em.flush() (single transaction)" style="swimlane;startSize=30;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=3;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="760" height="230" as="geometry"/></mxCell>
<mxCell id="cas1" value="5. soft-delete WorkspaceMembers&#xa;(WHERE workspaceId = id)" style="rounded=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontSize=11;" vertex="1" parent="cas_z"><mxGeometry x="10" y="50" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="cas2" value="6. soft-delete Posts&#xa;(WHERE workspaceId = id)" style="rounded=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontSize=11;" vertex="1" parent="cas_z"><mxGeometry x="230" y="50" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="cas3" value="7. soft-delete FacebookAccounts&#xa;(WHERE workspaceId = id)" style="rounded=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontSize=11;" vertex="1" parent="cas_z"><mxGeometry x="450" y="50" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="cas4" value="8. soft-delete Workspace itself&#xa;workspace.deletedAt = now()" style="rounded=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1;fontSize=11;" vertex="1" parent="cas_z"><mxGeometry x="10" y="140" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="cas5" value="9. em.flush()&#xa;→ all 4 UPDATEs in one TX" style="rounded=1;fillColor=#1b5e20;fontColor=#FFFFFF;strokeColor=#1b5e20;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="cas_z"><mxGeometry x="450" y="140" width="200" height="60" as="geometry"/></mxCell>

<!-- Event publish -->
<mxCell id="ev_z" value="10. After Commit — Publish Events (fire-and-forget)" style="swimlane;startSize=30;fillColor=#f3eafb;strokeColor=#9673a6;strokeWidth=3;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="760" height="200" as="geometry"/></mxCell>
<mxCell id="ev1" value="WorkspaceDeletedEvent&#xa;→ workspace.deleted&#xa;→ billing: cancel subscription" style="rounded=1;fillColor=#f3eafb;strokeColor=#9673a6;strokeWidth=1;fontSize=11;" vertex="1" parent="ev_z"><mxGeometry x="10" y="50" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="ev2" value="PostDeletedEvent × N&#xa;→ posts.deleted (per post)&#xa;→ search: remove index" style="rounded=1;fillColor=#f3eafb;strokeColor=#9673a6;strokeWidth=1;fontSize=11;" vertex="1" parent="ev_z"><mxGeometry x="230" y="50" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="ev3" value="WorkspaceMemberRemovedEvent × M&#xa;→ workspace.member-removed&#xa;→ notification + audit" style="rounded=1;fillColor=#f3eafb;strokeColor=#9673a6;strokeWidth=1;fontSize=11;" vertex="1" parent="ev_z"><mxGeometry x="450" y="50" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="ev_all" value="All above → audit_all_events_queue (# binding) → AuditConsumer → MongoDB" style="text;html=1;fontSize=10;fontStyle=2;fontColor=#4A4A4A;" vertex="1" parent="ev_z"><mxGeometry x="10" y="150" width="700" height="30" as="geometry"/></mxCell>

<!-- Async cron -->
<mxCell id="cron_z" value="11. WorkspacePurgeJob (@Cron '0 2 * * *')" style="swimlane;startSize=30;fillColor=#EEEEEE;strokeColor=#4A4A4A;strokeWidth=3;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="760" height="140" as="geometry"/></mxCell>
<mxCell id="cr1" value="SELECT id FROM workspaces&#xa;WHERE deletedAt &lt; now()-30d&#xa;LIMIT 500 (BATCH_SIZE)" style="rounded=1;fillColor=#EEEEEE;strokeColor=#4A4A4A;strokeWidth=1;fontSize=11;" vertex="1" parent="cron_z"><mxGeometry x="10" y="50" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="cr2" value="Hard-delete in FK order:&#xa;posts, members, facebook_accounts&#xa;→ finally workspaces" style="rounded=1;fillColor=#EEEEEE;strokeColor=#4A4A4A;strokeWidth=1;fontSize=11;" vertex="1" parent="cron_z"><mxGeometry x="260" y="50" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="cr3" value="Loops until batch empty&#xa;Jitter: random delay between batches&#xa;to avoid DB spike" style="rounded=1;fillColor=#EEEEEE;strokeColor=#4A4A4A;strokeWidth=1;fontSize=11;" vertex="1" parent="cron_z"><mxGeometry x="510" y="50" width="220" height="70" as="geometry"/></mxCell>

<mxCell id="resp" value="204 No Content (immediate — cron is async)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="60" width="300" height="60" as="geometry"/></mxCell>

<!-- Flow arrows -->
<mxCell id="fg_cas" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" source="guard_z" target="cas_z" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="fcas_ev" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" source="cas_z" target="ev_z" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="fev_cr" value="(nightly, async)" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeWidth=2;fontSize=9;" edge="1" source="ev_z" target="cron_z" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="fguard_resp" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" source="guard_z" target="resp" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>

