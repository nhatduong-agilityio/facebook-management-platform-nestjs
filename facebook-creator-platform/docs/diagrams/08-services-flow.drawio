<mxCell id="sc2" value="posts.updated&#xa;→ Algolia.partialUpdateObject()&#xa;update title/content" style="rounded=1;fillColor=#EAF1FE;strokeColor=#3A5BD9;strokeWidth=1;fontSize=11;" vertex="1" parent="con_z"><mxGeometry x="215" y="45" width="180" height="80" as="geometry"/></mxCell>
