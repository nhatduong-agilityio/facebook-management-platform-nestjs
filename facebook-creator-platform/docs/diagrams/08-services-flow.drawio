<mxCell id="rmq2" value="BillingService&#xa;.cancelWorkspaceSubscription()&#xa;Idempotent: ok() if already cancelled" style="rounded=1;fillColor=#fff8e1;strokeColor=#E0A21E;strokeWidth=2;fontSize=12;" vertex="1" parent="rmq_z"><mxGeometry x="265" y="40" width="230" height="70" as="geometry"/></mxCell>
