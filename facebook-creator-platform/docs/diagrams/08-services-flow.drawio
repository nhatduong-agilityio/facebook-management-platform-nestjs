<mxCell id="tcp3" value="billing.checkout&#xa;→ BillingService.createCheckoutSession()&#xa;← { url: stripe_checkout_url }" style="rounded=1;fillColor=#fff8e1;strokeColor=#E0A21E;strokeWidth=2;fontSize=11;" vertex="1" parent="tcp_z"><mxGeometry x="460" y="45" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="tcp_db" value="All queries read from billing_subscriptions table (PostgreSQL billing schema)" style="text;html=1;fontSize=10;fontStyle=2;" vertex="1" parent="tcp_z"><mxGeometry x="15" y="160" width="650" height="30" as="geometry"/></mxCell>

<!-- RMQ consumer -->
