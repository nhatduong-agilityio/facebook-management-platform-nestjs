<mxCell id="rmq_note" value="ADR-109 / W-1 Fix 4: moved from sync TCP orchestration to async choreography" style="text;html=1;fontSize=10;fontStyle=2;fontColor=#CC6600;" vertex="1" parent="rmq_z"><mxGeometry x="15" y="145" width="650" height="30" as="geometry"/></mxCell>
