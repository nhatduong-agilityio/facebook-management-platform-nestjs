<root><mxCell id="0"/><mxCell id="1" parent="0"/>

<mxCell id="title" value="Service Internal Flow — services/email" style="text;html=1;align=center;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="14" width="800" height="34" as="geometry"/></mxCell>
<mxCell id="sub" value="Pure RabbitMQ consumer. NestFactory.createMicroservice() — single transport. No HTTP, No TCP. Simplest service." style="text;html=1;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="50" width="1200" height="22" as="geometry"/></mxCell>

<!-- RMQ consumers -->
<mxCell id="con_z" value="RabbitMQ — email_events_queue (5 event consumers)" style="swimlane;startSize=30;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=3;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1100" height="350" as="geometry"/></mxCell>
<mxCell id="em1" value="workspace.member-invited&#xa;→ EmailService.sendInvite(email, token)&#xa;→ SMTP / SES template" style="rounded=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1;fontSize=11;" vertex="1" parent="con_z"><mxGeometry x="10" y="50" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="em2" value="posts.published&#xa;→ EmailService.sendPublishSuccess()&#xa;(optional — configurable)" style="rounded=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1;fontSize=11;" vertex="1" parent="con_z"><mxGeometry x="240" y="50" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="em3" value="posts.failed&#xa;→ EmailService.sendPublishFailed()&#xa;→ error details in email" style="rounded=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1;fontSize=11;" vertex="1" parent="con_z"><mxGeometry x="470" y="50" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="em4" value="billing.payment_failed&#xa;→ EmailService.sendPaymentFailed()&#xa;→ retry link in email" style="rounded=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1;fontSize=11;" vertex="1" parent="con_z"><mxGeometry x="700" y="50" width="210" height="90" as="geometry"/></mxCell>
<mxCell id="em5" value="facebook.token_expiring&#xa;→ EmailService.sendTokenExpiry()&#xa;→ re-auth link in email" style="rounded=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1;fontSize=11;" vertex="1" parent="con_z"><mxGeometry x="870" y="50" width="210" height="90" as="geometry"/></mxCell>

<mxCell id="em_flow" value="All consumers: extract data → render Handlebars/Mustache template → send via SMTP adapter (AWS SES or SMTP) → ack on success, nack+requeue on SMTP error." style="text;html=1;fontSize=10;fontStyle=2;" vertex="1" parent="con_z"><mxGeometry x="10" y="180" width="1060" height="30" as="geometry"/></mxCell>

<mxCell id="factory_note" value="NestFactory.createMicroservice() vs NestFactory.create():&#xa;• Email uses createMicroservice() — single transport, no DI container for HTTP adapter&#xa;• All other services use create() + connectMicroservice() for multi-transport support&#xa;(analytics: TCP + RMQ; billing: HTTP + TCP + RMQ)" style="rounded=1;fillColor=#fff2cc;strokeColor=#f9a825;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="460" width="900" height="120" as="geometry"/></mxCell>

<mxCell id="ds" value="Data Stores: None (stateless — sends email and acks). No DB, No Redis, No MongoDB." style="rounded=1;fillColor=#f9f9f9;strokeColor=#999999;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="970" y="460" width="580" height="70" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>

<!-- PAGE 6 — AUDIT SERVICE -->
<diagram id="svc_au" name="6. Audit Service">
<mxGraphModel dx="1600" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="800" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>

<mxCell id="title" value="Service Internal Flow — services/audit" style="text;html=1;align=center;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="14" width="800" height="34" as="geometry"/></mxCell>
<mxCell id="sub" value="Transports: TCP :3003 (read queries) + RabbitMQ audit_all_events_queue (# wildcard — ALL events). No HTTP (ADR-108)." style="text;html=1;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="50" width="1200" height="22" as="geometry"/></mxCell>

<!-- RMQ consumer -->
<mxCell id="rmq_z" value="RabbitMQ — audit_all_events_queue (binding: # — wildcard, all routing keys)" style="swimlane;startSize=30;fillColor=#EEEEEE;strokeColor=#4A4A4A;strokeWidth=3;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="900" height="280" as="geometry"/></mxCell>
<mxCell id="au1" value="Any event (ALL routing keys)&#xa;AuditConsumer @EventPattern('#')" style="rounded=1;fillColor=#EEEEEE;strokeColor=#4A4A4A;strokeWidth=2;fontSize=12;" vertex="1" parent="rmq_z"><mxGeometry x="15" y="50" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="au2" value="Extract: eventType, workspaceId,&#xa;userId, payload (strip PII)&#xa;Attach: correlationId, timestamp" style="rounded=1;fillColor=#EEEEEE;strokeColor=#4A4A4A;strokeWidth=2;fontSize=12;" vertex="1" parent="rmq_z"><mxGeometry x="310" y="50" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="au3" value="MongoDB insert&#xa;audit_events collection&#xa;(append-only, never deleted)" style="rounded=1;fillColor=#EEEEEE;strokeColor=#4A4A4A;strokeWidth=2;fontSize=12;" vertex="1" parent="rmq_z"><mxGeometry x="610" y="50" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="au_note" value="Idempotent: check eventId before insert to avoid duplicates on nack+requeue.&#xa;No Redis needed — MongoDB upsert with eventId as unique index." style="text;html=1;fontSize=10;fontStyle=2;" vertex="1" parent="rmq_z"><mxGeometry x="15" y="200" width="850" height="40" as="geometry"/></mxCell>
<mxCell id="ea12" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="au1" target="au2" parent="rmq_z"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ea23" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="au2" target="au3" parent="rmq_z"><mxGeometry relative="1" as="geometry"/></mxCell>

<!-- TCP -->
<mxCell id="tcp_z" value="TCP :3003 — @MessagePattern (read-only, Owner role only via apps/api RBAC)" style="swimlane;startSize=30;fillColor=#EEEEEE;strokeColor=#4A4A4A;strokeWidth=3;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="900" height="200" as="geometry"/></mxCell>
<mxCell id="at1" value="audit.get-logs&#xa;{ workspaceId, limit? }&#xa;← AuditEvent[] (newest first, limit 50)&#xa;MongoDB find().sort(-timestamp)" style="rounded=1;fillColor=#EEEEEE;strokeColor=#4A4A4A;strokeWidth=2;fontSize=11;" vertex="1" parent="tcp_z"><mxGeometry x="15" y="40" width="380" height="100" as="geometry"/></mxCell>
<mxCell id="at2" value="audit.get-log&#xa;{ id }&#xa;← AuditEvent | RpcException(NOT_FOUND)&#xa;MongoDB findById" style="rounded=1;fillColor=#EEEEEE;strokeColor=#4A4A4A;strokeWidth=2;fontSize=11;" vertex="1" parent="tcp_z"><mxGeometry x="430" y="40" width="380" height="100" as="geometry"/></mxCell>

<!-- DS + design note -->
<mxCell id="ds" value="Data Stores:&#xa;MongoDB (audit): audit_events collection. Index: { workspaceId: 1, timestamp: -1 }, { eventId: 1, unique: true }&#xa;No PostgreSQL, No Redis (MongoDB unique index serves as dedup)." style="rounded=1;fillColor=#f9f9f9;strokeColor=#999999;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="980" y="80" width="570" height="120" as="geometry"/></mxCell>
<mxCell id="design" value="Design note (CLAUDE.md §7):&#xa;Audit trail is NOT a PostgreSQL table.&#xa;Exposed read-only via apps/api (Owner role).&#xa;The # wildcard binding means this service&#xa;receives a copy of EVERY event in the system&#xa;— natural write-ahead log for compliance." style="rounded=1;fillColor=#fff2cc;strokeColor=#f9a825;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="980" y="220" width="570" height="170" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>

</mxfile>
