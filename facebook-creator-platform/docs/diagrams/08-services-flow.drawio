<!-- Data stores -->
<mxCell id="ds" value="Data Stores:&#xa;MongoDB (analytics): post_metrics collection (append-heavy, one doc per post-per-day)&#xa;Redis: dedup key (SET eventId NX EX 86400 — prevents double-processing of posts.published)&#xa;No PostgreSQL in this service" style="rounded=1;fillColor=#f9f9f9;strokeColor=#999999;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="740" height="130" as="geometry"/></mxCell>
