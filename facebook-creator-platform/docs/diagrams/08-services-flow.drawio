<!-- Inbound: TCP -->
<mxCell id="tcp_z" value="TCP :4001 — @MessagePattern (internal RPC from apps/api)" style="swimlane;startSize=30;fillColor=#fff8e1;strokeColor=#E0A21E;strokeWidth=3;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="700" height="240" as="geometry"/></mxCell>
