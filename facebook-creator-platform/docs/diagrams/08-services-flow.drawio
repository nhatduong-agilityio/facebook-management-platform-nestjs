<!-- TCP RPC -->
<mxCell id="tcp_z" value="TCP :3002 — @MessagePattern (read queries)" style="swimlane;startSize=30;fillColor=#E0F7F7;strokeColor=#2E9E9E;strokeWidth=3;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="460" width="700" height="200" as="geometry"/></mxCell>
<mxCell id="t1" value="analytics.workspace-metrics&#xa;→ MetricsService.getWorkspaceSummary()&#xa;← MetricsSummaryDto (MongoDB aggregate)" style="rounded=1;fillColor=#E0F7F7;strokeColor=#2E9E9E;strokeWidth=2;fontSize=11;" vertex="1" parent="tcp_z"><mxGeometry x="15" y="40" width="300" height="80" as="geometry"/></mxCell>
