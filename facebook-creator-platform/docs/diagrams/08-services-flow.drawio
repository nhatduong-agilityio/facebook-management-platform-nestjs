<mxCell id="sc4" value="posts.failed&#xa;→ Algolia.partialUpdateObject()&#xa;update status" style="rounded=1;fillColor=#EAF1FE;strokeColor=#3A5BD9;strokeWidth=1;fontSize=11;" vertex="1" parent="con_z"><mxGeometry x="615" y="45" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="sc5" value="posts.deleted&#xa;→ Algolia.deleteObject()&#xa;remove from index" style="rounded=1;fillColor=#EAF1FE;strokeColor=#3A5BD9;strokeWidth=1;fontSize=11;" vertex="1" parent="con_z"><mxGeometry x="815" y="45" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="algolia_note" value="All Algolia calls: idempotent by objectID = post.id. Redis dedup key per event. ack on success, nack+requeue on Algolia error." style="text;html=1;fontSize=10;fontStyle=2;" vertex="1" parent="con_z"><mxGeometry x="15" y="200" width="1050" height="30" as="geometry"/></mxCell>

<!-- TCP RPC -->
<mxCell id="tcp_z" value="TCP :3004 — @MessagePattern" style="swimlane;startSize=30;fillColor=#EAF1FE;strokeColor=#3A5BD9;strokeWidth=3;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="400" width="700" height="180" as="geometry"/></mxCell>
<mxCell id="st1" value="search.query&#xa;payload: { q, workspaceId, limit, cursor }&#xa;→ SearchService.query()&#xa;→ Algolia.search() with workspaceId filter&#xa;← { data: AlgoliaHit[], nextCursor }" style="rounded=1;fillColor=#EAF1FE;strokeColor=#3A5BD9;strokeWidth=2;fontSize=11;align=left;" vertex="1" parent="tcp_z"><mxGeometry x="15" y="40" width="650" height="120" as="geometry"/></mxCell>

<!-- Data stores -->
<mxCell id="ds" value="Data Stores:&#xa;Algolia: posts_index (per-workspace filterable). objectID = post.id&#xa;Redis: dedup keys only. No PostgreSQL, No MongoDB in this service." style="rounded=1;fillColor=#f9f9f9;strokeColor=#999999;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="740" height="110" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>

