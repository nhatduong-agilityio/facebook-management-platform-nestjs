{
  "name": "facebook-creator-platform",
  "private": true,
  "engines": {
    "node": ">=25",
    "pnpm": ">=10"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @fcp/api test",
    "test:billing": "pnpm --filter @fcp/billing test",
    "test:email": "pnpm --filter @fcp/email test",
    "build:libs": "pnpm -r --filter './libs/**' build",
    "build": "pnpm -r build",
    "start:dev": "pnpm --filter @fcp/api start:dev",
    "start:billing": "pnpm --filter @fcp/billing start:dev",
    "start:analytics": "pnpm --filter @fcp/analytics start:dev",
    "start:audit": "pnpm --filter @fcp/audit start:dev",
    "start:search": "pnpm --filter @fcp/search start:dev",
    "start:notification": "pnpm --filter @fcp/notification start:dev",
    "start:email": "pnpm --filter @fcp/email start:dev",
    "migration": "pnpm --filter @fcp/api mikro-orm migration:up",
    "migration:email": "pnpm --filter @fcp/email mikro-orm migration:up",
    "migration:billing": "pnpm --filter @fcp/billing mikro-orm migration:up",
    "migration:analytics": "pnpm --filter @fcp/analytics mikro-orm migration:up",
    "migration:notification": "pnpm --filter @fcp/notification mikro-orm migration:up",
    "e2e": "pnpm e2e:auth && pnpm e2e:workspaces && pnpm e2e:posts && pnpm e2e:services",
    "e2e:auth": "dotenv -- artillery run --record --output test/e2e/reports/auth.json test/e2e/auth.e2e.yml",
    "e2e:workspaces": "dotenv -- artillery run --record --output test/e2e/reports/workspaces.json test/e2e/workspaces.e2e.yml",
    "e2e:posts": "dotenv -- artillery run --record --output test/e2e/reports/posts.json test/e2e/posts.e2e.yml",
    "e2e:services": "dotenv -- artillery run --record --output test/e2e/reports/services.json test/e2e/services.e2e.yml",
    "load:smoke": "dotenv -- artillery run --record --output test/load/reports/smoke.json test/load/smoke.yml",
    "load:read": "dotenv -- artillery run --record --output test/load/reports/read.json test/load/read-dashboard.yml",
    "load:write": "dotenv -- artillery run --record --output test/load/reports/write.json test/load/write-posts.yml",
    "load:fanout": "dotenv -- artillery run --record --output test/load/reports/fanout.json test/load/publish-fanout.yml",
    "prepare": "git config core.hooksPath $(git rev-parse --show-prefix).husky"
  },
  "devDependencies": {
    "artillery": "^2.0.33",
    "dotenv-cli": "^11.0.0",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.29.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.3",
    "typescript-eslint": "^8.62.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "@scarf/scarf"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
