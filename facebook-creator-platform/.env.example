# Copy to .env and fill in. NEVER commit .env (it's gitignored and deny-listed for Claude).

# --- Core datastores ---
DATABASE_URL=postgres://fcp:fcp@localhost:5432/fcp
MONGODB_URI=mongodb://localhost:27017/fcp_audit
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Search (Algolia) ---
ALGOLIA_APP_ID=...
ALGOLIA_ADMIN_KEY=...

# --- Facebook Graph API ---
FACEBOOK_APP_ID=...
FACEBOOK_APP_SECRET=...
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/v1/facebook/callback

# --- Email provider ---
EMAIL_PROVIDER_API_KEY=...

# --- Slack (notifications) ---
SLACK_WEBHOOK_URL=...

# --- PII encryption (R2 / BR-F11) ---
# 32-byte key, base64. Generate: openssl rand -base64 32
PII_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY_ID=v1

# --- App ---
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# --- For Artillery load tests ---
TEST_JWT=
TEST_WORKSPACE_ID=

# --- For MCP servers in .mcp.json (your shell can export these instead) ---
GITHUB_MCP_PAT=
# CONTEXT7_API_KEY=
