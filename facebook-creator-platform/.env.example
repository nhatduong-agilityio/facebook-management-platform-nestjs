# Copy to .env and fill in. NEVER commit .env (it's gitignored and deny-listed for Claude).

# --- Core datastores ---
DATABASE_URL=postgres://fcp:fcp@localhost:5432/fcp
MONGODB_URI=mongodb://localhost:27017/fcp_audit
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RMQ_PREFETCH=10
RMQ_DLQ_PREFETCH=5

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Billing service ---
BILLING_PORT=3001
BILLING_SERVICE_URL=http://localhost:3001/api/v1
# Stripe redirects the browser to these URLs after checkout; must be accessible by the end user.
BILLING_SUCCESS_URL=http://localhost:3000/api/v1/billing/success
BILLING_CANCEL_URL=http://localhost:3000/api/v1/billing/cancel

# --- Search service ---
SEARCH_PORT=3004
SEARCH_SERVICE_URL=http://localhost:3004/api/v1

# --- Search (Algolia) ---
ALGOLIA_APP_ID=...
ALGOLIA_API_KEY=...
ALGOLIA_POSTS_INDEX=posts

# --- Facebook Graph API ---
FACEBOOK_APP_ID=...
FACEBOOK_APP_SECRET=...
# Local dev: use ngrok → https://<id>.ngrok-free.app/api/v1/facebook/callback
# Register this in Facebook App Dashboard → Facebook Login → Valid OAuth Redirect URIs
FACEBOOK_REDIRECT_URI=https://<id>.ngrok-free.app/api/v1/facebook/callback
# Any random string. Register in Facebook App Dashboard → Webhooks → Verify Token.
# Generate: openssl rand -hex 32
# Webhook Callback URL (local dev): https://<id>.ngrok-free.app/api/v1/webhooks/facebook
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# --- Analytics ---
ANALYTICS_PORT=3002
ANALYTICS_SERVICE_URL=http://localhost:3002/api/v1

# --- Audit ---
AUDIT_PORT=3003
AUDIT_SERVICE_URL=http://localhost:3003/api/v1

# --- Search ---
SEARCH_PORT=3004
SEARCH_SERVICE_URL=http://localhost:3004/api/v1

# --- Notification ---
NOTIFICATION_PORT=3005
NOTIFICATION_SERVICE_URL=http://localhost:3005/api/v1
SLACK_WEBHOOK_URL=

# --- Email service ---
EMAIL_PORT=3006
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com
# Resend template IDs (from Resend dashboard → Templates).
# If absent, a minimal inline HTML fallback is used (safe for local dev).
RESEND_TEMPLATE_MEMBER_INVITATION=
RESEND_TEMPLATE_POST_PUBLISHED=
RESEND_TEMPLATE_POST_FAILED=
RESEND_TEMPLATE_PAYMENT_FAILED=
RESEND_TEMPLATE_TOKEN_EXPIRING=

# --- Slack (notifications) ---
SLACK_WEBHOOK_URL=...

# --- PII encryption (R2 / BR-F11) ---
# 32-byte key, base64. Generate: openssl rand -base64 32
PII_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY_ID=v1

# --- App ---
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
APPS_API_INTERNAL_URL=http://localhost:3000/api/v1
INTERNAL_API_SECRET=

# --- For Artillery load tests ---
TEST_JWT=
TEST_WORKSPACE_ID=

# --- For MCP servers in .mcp.json (your shell can export these instead) ---
GITHUB_MCP_PAT=
# CONTEXT7_API_KEY=
