<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="fcp-hld" name="HighLevelDesign">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Facebook Creator Platform — High-Level Design (Request Lifecycle &amp; Event Flow)" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1200" height="40" as="geometry" />
        </mxCell>

        <!-- ===== TOP: Request lifecycle (NestJS pipeline) ===== -->
        <mxCell id="lc_band" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeColor=#2D6CDF;fillColor=#F4F8FF;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1480" height="260" as="geometry" />
        </mxCell>
        <mxCell id="lc_title" value="1) Synchronous Request Lifecycle  —  Client → apps/api (NestJS)" style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#1A3A6B;" vertex="1" parent="1">
          <mxGeometry x="80" y="92" width="900" height="24" as="geometry" />
        </mxCell>

        <mxCell id="p_client" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;Next.js" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2D6CDF;fillColor=#EAF1FE;fontColor=#1A3A6B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="120" height="64" as="geometry" /></mxCell>
        <mxCell id="p_mw" value="&lt;b&gt;Middleware&lt;/b&gt;&lt;br&gt;Clerk JWT" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#E08A1E;fillColor=#FFF3E0;fontColor=#7A4A0A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="245" y="150" width="120" height="64" as="geometry" /></mxCell>
        <mxCell id="p_guard" value="&lt;b&gt;Guard&lt;/b&gt;&lt;br&gt;RBAC (Roles)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C5392B;fillColor=#FDECEA;fontColor=#8A1F16;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="150" width="120" height="64" as="geometry" /></mxCell>
        <mxCell id="p_pipe" value="&lt;b&gt;Pipe&lt;/b&gt;&lt;br&gt;Validation (DTO)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2E9E5B;fillColor=#E6F7EC;fontColor=#1B5E33;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="150" width="130" height="64" as="geometry" /></mxCell>
        <mxCell id="p_ctrl" value="&lt;b&gt;Controller&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8A3FD9;fillColor=#F3EAFB;fontColor=#5A1B8B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="150" width="120" height="64" as="geometry" /></mxCell>
        <mxCell id="p_svc" value="&lt;b&gt;Application&lt;br&gt;Service&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8A3FD9;fillColor=#F3EAFB;fontColor=#5A1B8B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="915" y="150" width="120" height="64" as="geometry" /></mxCell>
        <mxCell id="p_repo" value="&lt;b&gt;Repository&lt;/b&gt;&lt;br&gt;TypeORM" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3A5BD9;fillColor=#EAF1FE;fontColor=#1A2E7A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="150" width="120" height="64" as="geometry" /></mxCell>
        <mxCell id="p_pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;strokeColor=#2D6CDF;fillColor=#EAF1FE;fontColor=#1A3A6B;fontSize=12;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="1"><mxGeometry x="1245" y="142" width="110" height="80" as="geometry" /></mxCell>
        <mxCell id="p_redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;cache check" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C5392B;fillColor=#FDECEA;fontColor=#8A1F16;fontSize=11;" vertex="1" parent="1"><mxGeometry x="915" y="250" width="120" height="50" as="geometry" /></mxCell>

        <mxCell id="le1" style="endArrow=block;html=1;strokeColor=#1A1A1A;strokeWidth=2;" edge="1" parent="1" source="p_client" target="p_mw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le2" style="endArrow=block;html=1;strokeColor=#1A1A1A;strokeWidth=2;" edge="1" parent="1" source="p_mw" target="p_guard"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le3" style="endArrow=block;html=1;strokeColor=#1A1A1A;strokeWidth=2;" edge="1" parent="1" source="p_guard" target="p_pipe"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le4" style="endArrow=block;html=1;strokeColor=#1A1A1A;strokeWidth=2;" edge="1" parent="1" source="p_pipe" target="p_ctrl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le5" style="endArrow=block;html=1;strokeColor=#1A1A1A;strokeWidth=2;" edge="1" parent="1" source="p_ctrl" target="p_svc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le6" style="endArrow=block;html=1;strokeColor=#1A1A1A;strokeWidth=2;" edge="1" parent="1" source="p_svc" target="p_repo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le7" style="endArrow=block;html=1;strokeColor=#1A1A1A;strokeWidth=2;" edge="1" parent="1" source="p_repo" target="p_pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le8" value="cache-first" style="endArrow=block;startArrow=block;html=1;dashed=1;strokeColor=#C5392B;strokeWidth=2;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p_svc" target="p_redis"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== MIDDLE: domain event publish ===== -->
        <mxCell id="ev_note" value="After business completion → publish Domain Event → RabbitMQ (AMQP)" style="text;html=1;align=center;fontSize=14;fontStyle=1;fontColor=#5A1B8B;" vertex="1" parent="1"><mxGeometry x="300" y="360" width="1000" height="26" as="geometry" /></mxCell>
        <mxCell id="ev_arrow" style="endArrow=block;html=1;strokeColor=#1A1A1A;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p_svc" target="rmq"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="rmq" value="&lt;b&gt;RabbitMQ Exchange&lt;/b&gt;  (topic)  —  routing keys: workspace.* · posts.* · billing.* · analytics.* · notification.* · email.* · search.*" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8A3FD9;fillColor=#F3EAFB;fontColor=#5A1B8B;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="400" width="1360" height="56" as="geometry" /></mxCell>

        <!-- ===== BOTTOM: Event Flow Example (Post Published) ===== -->
        <mxCell id="flow_band" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeColor=#8A3FD9;fillColor=#FBF7FE;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="490" width="1480" height="660" as="geometry" /></mxCell>
        <mxCell id="flow_title" value="2) Event Flow Example — &quot;Post Published&quot;  (eventual consistency via async consumers)" style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#5A1B8B;" vertex="1" parent="1">
          <mxGeometry x="80" y="502" width="1100" height="24" as="geometry" /></mxCell>

        <!-- step nodes -->
        <mxCell id="s1" value="&lt;b&gt;1. Posts Module (apps/api)&lt;/b&gt;&lt;br&gt;User publishes a post → write to PostgreSQL (core schema)&lt;br&gt;Emit domain event &lt;b&gt;PostPublished&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8A3FD9;fillColor=#F3EAFB;fontColor=#5A1B8B;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="545" width="600" height="70" as="geometry" /></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Publish Event&lt;/b&gt;&lt;br&gt;routing key &lt;b&gt;posts.published&lt;/b&gt; → RabbitMQ topic exchange&lt;br&gt;Publisher confirms; message persisted to durable queues" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8A3FD9;fillColor=#F3EAFB;fontColor=#5A1B8B;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="635" width="600" height="70" as="geometry" /></mxCell>

        <mxCell id="se1" style="endArrow=block;html=1;dashed=1;strokeColor=#8A3FD9;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- fan-out consumers -->
        <mxCell id="c_search" value="&lt;b&gt;3a. Search Service&lt;/b&gt;&lt;br&gt;consumes posts.published&lt;br&gt;→ index post in Algolia" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3A5BD9;fillColor=#EAF1FE;fontColor=#1A2E7A;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="760" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="c_notif" value="&lt;b&gt;3b. Notification Service&lt;/b&gt;&lt;br&gt;consumes posts.published&lt;br&gt;→ in-app notify workspace + Slack alert" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C5396B;fillColor=#FDEAF1;fontColor=#8A1640;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="490" y="760" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="c_email" value="&lt;b&gt;3c. Email Service&lt;/b&gt;&lt;br&gt;consumes posts.published&lt;br&gt;→ send publish-result email" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2E9E5B;fillColor=#E6F7EC;fontColor=#1B5E33;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="860" y="760" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="c_analytics" value="&lt;b&gt;3d. Analytics Service&lt;/b&gt;&lt;br&gt;schedules metrics sync (Graph API)&lt;br&gt;→ store aggregates (analytics schema)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2E9E9E;fillColor=#E0F7F7;fontColor=#0A5A5A;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1230" y="760" width="250" height="90" as="geometry" /></mxCell>

        <mxCell id="fe1" style="endArrow=block;html=1;dashed=1;strokeColor=#8A3FD9;strokeWidth=2;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="c_search"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe2" style="endArrow=block;html=1;dashed=1;strokeColor=#8A3FD9;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="c_notif"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe3" style="endArrow=block;html=1;dashed=1;strokeColor=#8A3FD9;strokeWidth=2;exitX=0.7;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="c_email"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe4" style="endArrow=block;html=1;dashed=1;strokeColor=#8A3FD9;strokeWidth=2;exitX=0.95;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="c_analytics"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- external targets -->
        <mxCell id="t_algolia" value="&lt;b&gt;Algolia&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1E47C8;fillColor=#E7ECFF;fontColor=#10277A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="900" width="170" height="44" as="geometry" /></mxCell>
        <mxCell id="t_slack" value="&lt;b&gt;Slack&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C5396B;fillColor=#FDEAF1;fontColor=#8A1640;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="900" width="170" height="44" as="geometry" /></mxCell>
        <mxCell id="t_emailp" value="&lt;b&gt;Email Provider&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2E9E5B;fillColor=#E6F7EC;fontColor=#1B5E33;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="900" width="170" height="44" as="geometry" /></mxCell>
        <mxCell id="t_graph" value="&lt;b&gt;Facebook Graph API&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2E9E9E;fillColor=#E0F7F7;fontColor=#0A5A5A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="900" width="170" height="44" as="geometry" /></mxCell>

        <mxCell id="te1" style="endArrow=block;html=1;dashed=1;strokeColor=#3A5BD9;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c_search" target="t_algolia"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te2" style="endArrow=block;html=1;dashed=1;strokeColor=#C5396B;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c_notif" target="t_slack"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te3" style="endArrow=block;html=1;dashed=1;strokeColor=#2E9E5B;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c_email" target="t_emailp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te4" style="endArrow=block;html=1;dashed=1;strokeColor=#2E9E9E;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c_analytics" target="t_graph"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- reliability note -->
        <mxCell id="rel" value="&lt;b&gt;Reliability:&lt;/b&gt; durable queues · manual ack · retry queue → Dead-Letter Queue (DLQ) · idempotent + at-least-once consumers · message deduplication" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#9AA7B8;fillColor=#FAFBFC;fontColor=#33424F;fontSize=12;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="980" width="1360" height="48" as="geometry" /></mxCell>

        <!-- subscription state machine -->
        <mxCell id="sm_title" value="Subscription State Machine (Billing Service)" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#7A560A;" vertex="1" parent="1"><mxGeometry x="120" y="1040" width="500" height="22" as="geometry" /></mxCell>
        <mxCell id="sm_trial" value="TRIAL" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#E0A21E;fillColor=#FFF8E1;fontColor=#7A560A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1070" width="110" height="44" as="geometry" /></mxCell>
        <mxCell id="sm_active" value="ACTIVE" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2E9E5B;fillColor=#E6F7EC;fontColor=#1B5E33;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="1070" width="110" height="44" as="geometry" /></mxCell>
        <mxCell id="sm_pastdue" value="PAST_DUE" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#E08A1E;fillColor=#FFF3E0;fontColor=#7A4A0A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="1070" width="120" height="44" as="geometry" /></mxCell>
        <mxCell id="sm_cancel" value="CANCELLED" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#C5392B;fillColor=#FDECEA;fontColor=#8A1F16;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="1070" width="120" height="44" as="geometry" /></mxCell>

        <mxCell id="sme1" style="endArrow=block;html=1;strokeColor=#5A5A5A;strokeWidth=1.5;" edge="1" parent="1" source="sm_trial" target="sm_active"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sme2" style="endArrow=block;html=1;strokeColor=#5A5A5A;strokeWidth=1.5;" edge="1" parent="1" source="sm_active" target="sm_pastdue"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sme3" style="endArrow=block;html=1;strokeColor=#5A5A5A;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="sm_pastdue" target="sm_active"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sme4" style="endArrow=block;html=1;strokeColor=#5A5A5A;strokeWidth=1.5;" edge="1" parent="1" source="sm_pastdue" target="sm_cancel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sme5" style="endArrow=block;html=1;strokeColor=#5A5A5A;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="sm_active" target="sm_cancel"><mxGeometry relative="1" as="geometry" /></mxCell>

